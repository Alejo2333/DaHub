# Optional. Trystero needs no keys. Override the signalling app id to isolate deployments.
VITE_APP_ID=lucky-debt-hub-v1
# Optional TURN relay (see README). Separate several URLs with commas, e.g.
# VITE_TURN_URL=turn:example.com:80,turn:example.com:80?transport=tcp,turns:example.com:443?transport=tcp
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
